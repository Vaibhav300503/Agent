# SOC Platform Log Rotation Configuration
# This file should be placed in /etc/logrotate.d/soc-platform

/var/log/soc-platform.log /var/log/soc-platform-error.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        systemctl reload soc-platform >/dev/null 2>&1 || true
    endscript
}
